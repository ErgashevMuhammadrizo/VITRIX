DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=your-account@gmail.com
EMAIL_HOST_PASSWORD=your-google-app-password
DEFAULT_FROM_EMAIL=VITRIX <your-account@gmail.com>

# Production: set DATABASE_URL to PostgreSQL and use a persistent MEDIA_ROOT volume.
# DATABASE_URL=postgresql://vitrix:password@localhost:5432/vitrix

FRONTEND_URL=http://localhost:3000
# Set in frontend admin settings, or use this fallback (without @):
SUBSCRIPTION_TELEGRAM=
