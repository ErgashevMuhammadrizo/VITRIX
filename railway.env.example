PORT=8080
NODE_ENV=production
DJANGO_API_URL=http://127.0.0.1:9000
NEXT_PUBLIC_SITE_URL=https://vitrix-production.up.railway.app
SITE_URL=https://vitrix-production.up.railway.app
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=GENERATE_A_NEW_SECRET
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,vitrix-production.up.railway.app
DJANGO_SECURE_COOKIES=1
CSRF_TRUSTED_ORIGINS=https://vitrix-production.up.railway.app
FRONTEND_URL=https://vitrix-production.up.railway.app
DATABASE_PATH=/data/db.sqlite3
MEDIA_ROOT=/data/media
EMAIL_BACKEND=accounts.gmail_backend.GmailAPIBackend
DEFAULT_FROM_EMAIL=VITRIX <YOUR_AUTHORIZED_GMAIL@gmail.com>
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
SUBSCRIPTION_TELEGRAM=rizo_coder
# Keep disabled unless the upstream ingress is verified to OVERWRITE X-Forwarded-For.
TRUST_PROXY_IP=0
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
